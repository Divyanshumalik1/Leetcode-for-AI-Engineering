# Copy this file to .env and fill in only what you use. .env is git-ignored.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Azure (or use `az login` + managed identity and leave the key empty)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# AWS uses your CLI profile (`aws configure sso` or `aws configure`)
AWS_PROFILE=
AWS_REGION=us-east-1

# Local models
OLLAMA_HOST=http://localhost:11434

# Set to 1 to run tests marked @pytest.mark.live (these spend money)
RUN_LIVE=0
