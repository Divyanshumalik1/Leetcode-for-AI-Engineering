{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["node"],
    "paths": { "@common/*": ["./common/*"] }
  },
  "include": ["**/*.ts", "**/*.js"],
  "exclude": ["node_modules", "_templates", "**/attempts", ".venv"]
}
